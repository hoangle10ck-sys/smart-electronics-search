PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
# Local development only. Tests use the isolated smart_electronics_ingestion_test database.
MONGODB_URI=mongodb://127.0.0.1:27017/smart_electronics

# TechAPI source storage. Mongo remains the default.
TECHAPI_STORAGE=mongo
# SQLite runtime reads are always read-only. Set readwrite only in a dedicated
# importer process that is intentionally allowed to update the TechAPI archive.
TECHAPI_SQLITE_ACCESS=readonly
# Required only when TECHAPI_STORAGE=sqlite; must be an absolute directory
# outside the Git repository containing techapi_catalog.sqlite.
# TECHAPI_ARCHIVE_DIR=D:\SmartElectronicsData
TECHAPI_SQLITE_LOCK_TIMEOUT_MS=30000
SEARCH_PROVIDER=auto
TAVILY_API_KEY=REPLACE_WITH_YOUR_TAVILY_API_KEY
BRAVE_SEARCH_API_KEY=REPLACE_WITH_YOUR_BRAVE_SEARCH_API_KEY
LIVE_SEARCH_MAX_REQUESTS_PER_MINUTE=8
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_QUERY_MODEL=qwen3:4b
OLLAMA_QUERY_TIMEOUT_MS=60000
OLLAMA_CHAT_TIMEOUT_MS=90000
CHAT_MAX_REQUESTS_PER_MINUTE=15
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_EMBEDDING_TIMEOUT_MS=90000
MONGODB_VECTOR_SEARCH_INDEX=product_embedding_vector_index
MONGODB_VECTOR_DIMENSIONS=1024
MONGODB_VECTOR_SEARCH_ENABLED=false
ACCESSTRADE_API_KEY=REPLACE_WITH_YOUR_ACCESSTRADE_API_KEY
ACCESSTRADE_BASE_URL=https://api.accesstrade.vn/v1
ACCESSTRADE_DOMAIN=fptshop.com.vn
ADMIN_API_TOKEN=REPLACE_WITH_YOUR_ADMIN_API_TOKEN
TECHAPI_SOC_IMPORT_LOCK_DIR=
TECHAPI_SOC_IMPORT_LOCK_TIMEOUT_MS=30000
TECHAPI_MONGO_DESTINATION_URI=
TECHAPI_MONGO_DESTINATION_DATABASE=
TECHAPI_MONGO_DESTINATION_ALLOWED_HOSTS=
TECHAPI_SOURCE_READONLY_URI=
