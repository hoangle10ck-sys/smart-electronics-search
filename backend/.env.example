PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
# Local development only. Tests use the isolated smart_electronics_ingestion_test database.
MONGODB_URI=mongodb://127.0.0.1:27017/smart_electronics
SEARCH_PROVIDER=auto
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
LIVE_SEARCH_MAX_REQUESTS_PER_MINUTE=8
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_QUERY_MODEL=qwen3:4b
OLLAMA_QUERY_TIMEOUT_MS=60000
OLLAMA_CHAT_TIMEOUT_MS=90000
CHAT_MAX_REQUESTS_PER_MINUTE=15
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_EMBEDDING_TIMEOUT_MS=90000
MONGODB_VECTOR_SEARCH_INDEX=product_embedding_vector_index
MONGODB_VECTOR_DIMENSIONS=1024
MONGODB_VECTOR_SEARCH_ENABLED=false
ACCESSTRADE_API_KEY=
ACCESSTRADE_BASE_URL=https://api.accesstrade.vn/v1
ACCESSTRADE_DOMAIN=fptshop.com.vn
ADMIN_API_TOKEN=
